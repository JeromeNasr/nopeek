# Accounts and cloud sync (optional). Without these the app is local-only: everything is
# saved in the visitor's browser and nothing is sent anywhere.
# - Local development: put them in .env.development (or .env.development.local).
# - A deployed site: set them in your host's environment variables (see docs/DEPLOY.md).
#   Production builds never read .env.development, so a public site stays local-only
#   unless you deliberately add them there.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional, for public deployments:
# VITE_FEEDBACK_URL=https://forms.gle/your-feedback-form
# VITE_SOURCE_URL=https://github.com/you/your-repo
